# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/booknest?retryWrites=true&w=majority

# JWT Configuration (use a long, random string in production)
JWT_SECRET=replace_with_a_strong_random_secret_key
JWT_EXPIRES_IN=7d

# Allowed Frontend Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Initial Admin Account (used only when running: npm run seed)
ADMIN_NAME=BookNest Admin
ADMIN_EMAIL=admin@booknest.com
ADMIN_PASSWORD=replace_with_strong_admin_password
